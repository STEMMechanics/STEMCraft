package dev.stemcraft.minigames;

import dev.stemcraft.api.services.hologram.HologramTypeHandler;
import dev.stemcraft.api.services.region.RegionListener;
import dev.stemcraft.api.utils.SCPlayer;

import dev.stemcraft.STEMCraft;
import dev.stemcraft.api.commands.STEMCraftCommandContext;
import dev.stemcraft.api.utils.SCRegion;
import lombok.Getter;
import lombok.Setter;
import org.bukkit.Bukkit;
import org.bukkit.GameMode;
import org.bukkit.Location;
import org.bukkit.World;
import org.bukkit.configuration.ConfigurationSection;
import org.bukkit.configuration.file.YamlConfiguration;
import org.bukkit.entity.Player;
import org.bukkit.scheduler.BukkitTask;
import org.bukkit.scoreboard.DisplaySlot;
import org.bukkit.scoreboard.Objective;
import org.bukkit.scoreboard.Scoreboard;

import org.bukkit.Color;
import org.bukkit.entity.Firework;
import org.bukkit.inventory.meta.FireworkMeta;
import org.bukkit.FireworkEffect;

import java.io.File;
import java.io.IOException;
import java.util.*;

public class ParkourMiniGame extends STEMCraftMiniGame {
    private STEMCraft plugin;
    private final Map<String, ParkourCourse> courses = new HashMap<>();
    private final Map<UUID, ActiveRun> activeRuns = new HashMap<>();
    private final Random random = new Random();
    private static final String END_REGION_ID_PREFIX = "parkour:end:";
    private static int repeatingTaskCount = 0;

    @Override
    public void onLoad(STEMCraft plugin) {
        this.plugin = plugin;

        plugin.tabCompleteService().register("parkour", (player, args) -> new ArrayList<>(courses.keySet()));
        plugin.registerCommand("parkour")
                .setUsage("/parkour <create|edit|delete|enable|disable|setstart|setend|start|end> ...")
                .setDescription("Manage and play parkour minigames")
                .setPermission("stemcraft.command.parkour")
                .addTabCompletion("create", "", "{world}")
                .addTabCompletion("edit", "{parkour}")
                .addTabCompletion("delete", "{parkour}")
                .addTabCompletion("enable", "{parkour}")
                .addTabCompletion("disable", "{parkour}")
                .addTabCompletion("setstart", "{parkour}")
                .addTabCompletion("setend", "{parkour}")
                .addTabCompletion("start", "{parkour}", "{player}")
                .addTabCompletion("end", "{player}")
                .setExecutor((api, cmd, ctx) -> {
                    ctx.checkArgsNotEmpty();

                    String sub = ctx.getArg(1).toLowerCase(Locale.ROOT);
                    switch (sub) {
                        case "create" -> handleCreate(ctx);
                        case "edit" -> handleEdit(ctx);
                        case "delete" -> handleDelete(ctx);
                        case "enable" -> handleEnable(ctx, true);
                        case "disable" -> handleEnable(ctx, false);
                        case "setstart" -> handleSetRegion(ctx, true);
                        case "setend" -> handleSetRegion(ctx, false);
                        case "start" -> handleStart(ctx);
                        case "end" -> handleEnd(ctx);
                        default -> ctx.returnError("Unknown subcommand. Usage: " + cmd.getUsage());
                    }
                })
                .register(plugin);

        loadCourses();

        plugin.hologramService().registerType("parkour", new HologramTypeHandler() {
            @Override
            public List<String> list(String type) {
                return List.of();
            }

            @Override
            public List<String> lines(String type, String context, int id, List<String> data) {
                List<String> out = new ArrayList<>();

                out.add("<gold><bold>Parkour</bold></gold>");
                out.add("<yellow>Counter: " + repeatingTaskCount + "</yellow>");

                return out;
            }
        });

        plugin.taskService().repeating("parkour-repeating", 20L, 20L, () -> {
                repeatingTaskCount++;
                plugin.hologramService().update("parkour", null);
        });
    }

    @Override
    public void onUnload() {
        // cleanup tasks
        for (ActiveRun run : activeRuns.values()) {
            if (run.task != null) run.task.cancel();
        }
        activeRuns.clear();
        saveCourses();
    }

    // ---------- Commands ----------



    private void handleCreate(STEMCraftCommandContext ctx) {
        ctx.checkNotConsole();
        ctx.checkArgsSizeAtLeast(3);
        ctx.checkArgIsWorld(3);

        String name = ctx.getArgLower(2);
        String worldName = ctx.getArg(3);

        ParkourCourse course = new ParkourCourse(name, worldName);
        courses.put(name, course);
        saveCourses();

        ctx.returnInfo("Created parkour '" + name + "' in world '" + worldName + "'.");
    }

    private void handleEdit(STEMCraftCommandContext ctx) {
        ctx.checkNotConsole();
        ctx.checkArgsSizeAtLeast(2);

        String name = ctx.getArgLower(1);
        ParkourCourse course = requireCourse(ctx, name);
        if (course == null) return;

        Player p = ctx.getSenderAsPlayer();
        World world = Bukkit.getWorld(course.getWorldName());
        if (world == null) ctx.returnError("World for that parkour does not exist.");
        SCPlayer.teleport(p, world.getSpawnLocation());
        p.setGameMode(GameMode.CREATIVE);
        ctx.returnInfo("Editing parkour '" + name + "'.");
    }

    private void handleDelete(STEMCraftCommandContext ctx) {
        ctx.checkArgsSizeAtLeast(2);

        String name = ctx.getArgLower(1);
        if (courses.remove(name) == null) {
            ctx.returnError("No such parkour '" + name + "'.");
        }
        saveCourses();
        ctx.returnInfo("Deleted parkour '" + name + "'. World was not deleted.");
    }

    private void handleEnable(STEMCraftCommandContext ctx, boolean enable) {
        ctx.checkArgsSizeAtLeast(2);
        String name = ctx.getArgLower(2);
        ParkourCourse course = requireCourse(ctx, name);
        if (course == null) return;

        course.setEnabled(enable);
        saveCourses();
        ctx.returnInfo((enable ? "Enabled" : "Disabled") + " parkour '" + name + "'.");
    }

    private void handleSetRegion(STEMCraftCommandContext ctx, boolean start) {
        ctx.checkNotConsole();
        ctx.checkArgsSizeAtLeast(2);

        String name = ctx.getArgLower(1);
        ParkourCourse course = requireCourse(ctx, name);
        if (course == null) return;

        Player p = ctx.getSenderAsPlayer();
        Location loc = p.getLocation();
        String worldName = course.getWorldName();
        if (!loc.getWorld().getName().equals(worldName)) {
            ctx.returnError("You must stand in the parkour world to set regions.");
        }

        SCRegion region = SCRegion.getWESelection(p);
        if(region == null) {
            ctx.returnError("No WorldEdit selection found. Make a selection first.");
        }
        if (start) {
            course.setStartRegion(region);
        } else {
            course.setEndRegion(region);
            registerEndRegionListener(course);
        }

        saveCourses();
        ctx.returnInfo((start ? "Start" : "End") + " region set for '" + name + "'.");
    }

    private void handleStart(STEMCraftCommandContext ctx) {
        ctx.checkArgsSizeAtLeast(2);
        ctx.checkArgIsPlayerIfConsole(3);

        String name = ctx.getArgLower(2);
        ParkourCourse course = requireCourse(ctx, name);
        if (course == null) return;
        if (!course.isEnabled()) ctx.returnError("That parkour is disabled.");
        if (course.getStartRegion() == null || course.getEndRegion() == null) {
            ctx.returnError("Start or end region not set.");
        }

        Player target = ctx.getArgAsPlayerOrSender(3);
        startRun(target, course);
        ctx.returnInfo("Started parkour '" + name + "' for " + target.getName() + ".");
    }

    private void handleEnd(STEMCraftCommandContext ctx) {
        ctx.checkArgIsPlayerIfConsole(2);
        Player target = ctx.getArgAsPlayerOrSender(2);

        ActiveRun run = activeRuns.remove(target.getUniqueId());
        if (run == null) {
            ctx.returnError("That player is not currently running a parkour.");
        }
        if (run.task != null) run.task.cancel();
        Location returnLocation = run.returnLocation;
        target.setScoreboard(Bukkit.getScoreboardManager().getMainScoreboard());
        if (returnLocation != null) {
            SCPlayer.teleport(target, returnLocation);
        }

        ctx.returnInfo("Ended parkour run for " + target.getName() + ".");
    }

    private ParkourCourse requireCourse(STEMCraftCommandContext ctx, String name) {
        ParkourCourse c = courses.get(name);
        if (c == null) ctx.returnError("No such parkour '" + name + "'.");
        return c;
    }

    // ---------- Runs + scoreboard ----------

    private void startRun(Player p, ParkourCourse course) {
        // cancel any existing run
        ActiveRun existing = activeRuns.remove(p.getUniqueId());
        if (existing != null && existing.task != null) existing.task.cancel();

        Location returnLocation = p.getLocation().clone();
        Location spawn = course.getStartRegion().getRandomGroundLocation();
        if (spawn == null) {
            p.sendMessage("Start region world not found.");
            return;
        }

        SCPlayer.teleport(p, spawn);
        p.setGameMode(GameMode.ADVENTURE);

        long start = System.currentTimeMillis();
        Scoreboard board = Bukkit.getScoreboardManager().getNewScoreboard();
        Objective obj = board.registerNewObjective("parkour", "dummy", "Parkour - " + course.getName());
        obj.setDisplaySlot(DisplaySlot.SIDEBAR);

        ActiveRun run = new ActiveRun(course, start, board, null, returnLocation);
        activeRuns.put(p.getUniqueId(), run);
        p.setScoreboard(board);

        // schedule scoreboard updates
        run.task = Bukkit.getScheduler().runTaskTimer(plugin, () -> updateScoreboard(p, run), 0L, 20L);
    }

    private void updateScoreboard(Player p, ActiveRun run) {
        if (!p.isOnline()) {
            if (run.task != null) run.task.cancel();
            activeRuns.remove(p.getUniqueId());
            return;
        }

        long elapsed = System.currentTimeMillis() - run.startMillis;
        double seconds = elapsed / 1000.0;

        Scoreboard board = run.board;
        Objective obj = board.getObjective("parkour");
        if (obj == null) return;

        // clear
        for (String entry : new HashSet<>(board.getEntries())) {
            board.resetScores(entry);
        }

        String timeLine = String.format("Your time: %.3fs", seconds);
        obj.getScore(timeLine).setScore(4);

        obj.getScore("----------------").setScore(3);

        List<BestTime> top = run.course.getTop3();
        if (top.isEmpty()) {
            obj.getScore("No records yet").setScore(2);
        } else {
            for (int i = 0; i < top.size(); i++) {
                BestTime t = top.get(i);
                String line = String.format("#%d %s: %.3fs", i + 1, t.playerName(),
                        t.timeMillis() / 1000.0);
                obj.getScore(line).setScore(2 - i);
            }
        }
    }

    private void completeRun(Player p, ParkourCourse course) {
        ActiveRun run = activeRuns.remove(p.getUniqueId());
        if (run == null) return;
        if (run.task != null) run.task.cancel();

        long elapsed = System.currentTimeMillis() - run.startMillis;
        Location returnLocation = run.returnLocation;
        p.setScoreboard(Bukkit.getScoreboardManager().getMainScoreboard());

        course.addTime(p.getUniqueId(), p.getName(), elapsed);
        saveCourses();

        p.sendMessage("§aParkour completed in " + (elapsed / 1000.0) + "s!");

        // spawn some celebration fireworks at the player's location
        spawnCelebrationFireworks(p);

        // teleport back to where they came from after a short delay
        if (returnLocation != null) {
            Bukkit.getScheduler().runTaskLater(plugin, () -> SCPlayer.teleport(p, returnLocation), 20L * 3);
        }

        // TODO: trigger hologram refresh here if you cache holograms
    }

    private void spawnCelebrationFireworks(Player player) {
        World world = player.getWorld();
        Location loc = player.getLocation().clone().add(0, 1, 0);

        Firework firework = world.spawn(loc, Firework.class);
        FireworkMeta meta = firework.getFireworkMeta();
        meta.addEffect(FireworkEffect.builder()
                .withColor(Color.LIME)
                .withFade(Color.WHITE)
                .with(FireworkEffect.Type.BALL_LARGE)
                .trail(true)
                .flicker(true)
                .build());
        meta.setPower(1);
        firework.setFireworkMeta(meta);
    }

    private static class ActiveRun {
        final ParkourCourse course;
        final long startMillis;
        final Scoreboard board;
        final Location returnLocation;
        BukkitTask task;

        ActiveRun(ParkourCourse course, long startMillis, Scoreboard board, BukkitTask task, Location returnLocation) {
            this.course = course;
            this.startMillis = startMillis;
            this.board = board;
            this.task = task;
            this.returnLocation = returnLocation;
        }
    }

    // ---------- Persistence (YAML) ----------

    private void loadCourses() {
        File file = new File(plugin.getDataFolder(), "parkour.yml");
        if (!file.exists()) return;

        YamlConfiguration cfg = YamlConfiguration.loadConfiguration(file);
        ConfigurationSection sec = cfg.getConfigurationSection("courses");
        if (sec == null) return;

        for (String name : sec.getKeys(false)) {
            ConfigurationSection csec = sec.getConfigurationSection(name);
            if (csec == null) continue;

            String worldName = csec.getString("world");
            ParkourCourse course = new ParkourCourse(name, worldName);
            course.setEnabled(csec.getBoolean("enabled", false));

            if (csec.isConfigurationSection("start")) {
                course.setStartRegion((SCRegion)csec.get("start"));
            }
            if (csec.isConfigurationSection("end")) {
                course.setEndRegion((SCRegion)csec.get("end"));
            }

            ConfigurationSection timesSec = csec.getConfigurationSection("times");
            if (timesSec != null) {
                for (String key : timesSec.getKeys(false)) {
                    ConfigurationSection tsec = timesSec.getConfigurationSection(key);
                    UUID uuid = UUID.fromString(tsec.getString("uuid"));
                    String playerName = tsec.getString("name");
                    long millis = tsec.getLong("time");
                    course.addTime(uuid, playerName, millis);
                }
            }

            courses.put(name, course);
            registerEndRegionListener(course);
        }
    }

    private void registerEndRegionListener(ParkourCourse course) {
        if (course.getEndRegion() == null) return;

        String id = END_REGION_ID_PREFIX + course.getName();
        // Ensure old listener (if any) is removed first
        plugin.regionService().removeRegionListener(id);

        plugin.regionService().addRegionListener(id, course.getEndRegion(), new RegionListener() {
            @Override
            public void onEnter(Player player, SCRegion region) {
                ActiveRun run = activeRuns.get(player.getUniqueId());
                if (run == null) return;
                if (run.course != course) return;
                completeRun(player, course);
            }
        });
    }

    private void saveCourses() {
        File file = new File(plugin.getDataFolder(), "parkour.yml");
        YamlConfiguration cfg = new YamlConfiguration();
        ConfigurationSection sec = cfg.createSection("courses");

        for (ParkourCourse course : courses.values()) {
            ConfigurationSection csec = sec.createSection(course.getName());
            csec.set("world", course.getWorldName());
            csec.set("enabled", course.isEnabled());

            if (course.getStartRegion() != null) {
                csec.set("start", course.getStartRegion());

            }
            if (course.getEndRegion() != null) {
                csec.set("end", course.getEndRegion());
            }

            ConfigurationSection timesSec = csec.createSection("times");
            List<BestTime> times = course.getBestTimes();
            for (int i = 0; i < times.size(); i++) {
                BestTime t = times.get(i);
                ConfigurationSection tsec = timesSec.createSection(String.valueOf(i));
                tsec.set("uuid", t.playerId().toString());
                tsec.set("name", t.playerName());
                tsec.set("time", t.timeMillis());
            }
        }

        try {
            cfg.save(file);
        } catch (IOException e) {
            plugin.getLogger().warning("Failed to save parkour.yml: " + e.getMessage());
        }
    }

    @Getter
    static class ParkourCourse {
        private final String name;
        private final String worldName;
        @Setter
        private boolean enabled;
        @Setter
        private SCRegion startRegion;
        @Setter
        private SCRegion endRegion;

        // sorted by time ascending
        private final List<BestTime> bestTimes = new ArrayList<>();

        public ParkourCourse(String name, String worldName) {
            this.name = name;
            this.worldName = worldName;
        }

        public void addTime(UUID uuid, String name, long millis) {
            bestTimes.add(new BestTime(uuid, name, millis));
            bestTimes.sort(Comparator.comparingLong(BestTime::timeMillis));
            // cap at, say, top 50
            while (bestTimes.size() > 50) bestTimes.removeLast();
        }

        public OptionalLong getBestTime(UUID uuid) {
            return bestTimes.stream()
                    .filter(t -> t.playerId().equals(uuid))
                    .mapToLong(BestTime::timeMillis)
                    .min();
        }

        public List<BestTime> getTop3() {
            return bestTimes.subList(0, Math.min(3, bestTimes.size()));
        }

    }

    public record BestTime(UUID playerId, String playerName, long timeMillis) {}
}